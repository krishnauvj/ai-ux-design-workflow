# Example environment variables
# Copy this to .env and fill in your values

# Application Settings
APP_NAME=ai-ux-design-workflow
DEBUG=false
LOG_LEVEL=INFO

# Agent Settings
MAX_AGENTS=10
AGENT_TIMEOUT=300

# API Settings
API_TIMEOUT=30
MAX_RETRIES=3

# Workflow Settings
ENABLE_PERSISTENCE=true
OUTPUT_DIR=outputs

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Optional: API Keys for LLM Integration
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
